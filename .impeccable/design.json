      "html": "<button class=\"ds-primary\">Details</button>",
      "css": ".ds-primary{background:var(--accent,#4469dc);color:#fff;padding:8px 11px;min-height:44px;border:0;border-radius:8px;font:500 12px \"DM Sans\",sans-serif}.ds-primary:hover{background:var(--accent-hover,#3154c4)}.ds-primary:focus-visible{outline:3px solid var(--accent,#4469dc);outline-offset:4px}"
