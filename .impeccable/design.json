      "css": ".ds-launch{position:relative;width:100%;min-height:54px;padding:13px 54px 13px 24px;background:#8350e3;color:white;border:0;border-radius:30px;font:600 14px \"DM Sans\",sans-serif}.ds-launch svg{position:absolute;right:8px;top:8px;width:38px;height:38px;box-sizing:border-box;padding:9px;background:white;color:#8350e3;border-radius:50%}.ds-launch:hover{background:#7140cf}.ds-launch:focus-visible{outline:3px solid var(--accent,#4469dc);outline-offset:4px}"
    }
