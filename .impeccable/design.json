    {
      "name": "Provider Card",
      "kind": "card",
      "refersTo": "provider-card",
      "description": "Shared white provider container with warm hover/focus.",
      "html": "<article class=\"ds-card\"><h3>Provider name</h3><p>Provider details come from the directory record.</p><ul><li>Authentication: Not documented</li><li>Data format: Not documented</li></ul><button>Details</button></article>",
      "css": ".ds-card{position:relative;isolation:isolate;overflow:hidden;background:var(--surface,#fff);color:var(--ink,#222331);border-radius:16px;padding:24px 22px 20px;box-shadow:0 5px 20px rgba(46,43,82,.085);font:13px/1.7 \"DM Sans\",sans-serif}.ds-card::before{content:\"\";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 100% 53%,rgba(255,173,38,.44),rgba(255,215,132,.24) 32%,transparent 70%);opacity:0;transition:opacity .3s cubic-bezier(.16,1,.3,1)}.ds-card:hover::before,.ds-card:focus-within::before{opacity:1}.ds-card:hover,.ds-card:focus-within{box-shadow:0 12px 32px rgba(46,43,82,.13)}.ds-card h3{font-size:18px;line-height:1.35;margin:0}.ds-card p{color:var(--muted,#626274)}.ds-card button{background:var(--accent,#4469dc);color:white;border:0;border-radius:8px;min-height:44px;padding:8px 11px}.ds-card button:focus-visible{outline:3px solid var(--accent,#4469dc);outline-offset:4px}"
    },
