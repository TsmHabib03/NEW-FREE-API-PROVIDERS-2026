      "name": "Collection Navigation",
      "kind": "nav",
      "description": "Filter collections above the directory.",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"true\">All providers</button><button>Top picks</button><button>Recommended</button></nav>",
      "css": ".ds-nav{display:flex;gap:18px;border-bottom:1px solid var(--line,#eeeef4);overflow:auto}.ds-nav button{flex-shrink:0;border:0;background:transparent;min-height:49px;padding:0;font:500 11px \"DM Sans\",sans-serif;color:var(--muted,#626274)}.ds-nav button[aria-current=true]{color:var(--accent,#4469dc);border-bottom:2px solid var(--accent,#4469dc)}.ds-nav button:hover{color:var(--accent,#4469dc)}.ds-nav button:focus-visible{outline:3px solid var(--accent,#4469dc);outline-offset:-3px}"
