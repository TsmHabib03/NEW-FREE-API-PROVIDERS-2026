  "narrative": {
    "northStar": "Useful discovery, warm focus.",
    "overview": "The directory is a quiet white workspace held by a lavender canvas. Provider content owns the hierarchy. Warm radial light marks the card a visitor is exploring; a violet fade and floating logo give the selected provider a focused details view.\n\nThis documents the implemented directory in index.html. The existing setup documentation has its own styling. Values are derived from code; browser rendering and reference fidelity remain unverified because the browser access host is unavailable.",
    "keyCharacteristics": [
      "Lavender framing with white content surfaces.",
      "Compact metadata and readable provider descriptions.",
      "Warm card hover and focus with a violet details modal.",
      "Honest unknown, offline and missing-link states."
    ],
    "rules": [
      {
        "name": "The Truth Rule",
        "body": "Color may distinguish a recorded state; it must not imply measured reliability or an undocumented capability.",
        "section": "colors"
      },
      {
        "name": "The Code Rule",
        "body": "Monospace identifies literal model IDs or copyable codes.",
        "section": "typography"
      },
      {
        "name": "The Unknown Rule",
        "body": "Unpublished metrics render \"Not listed\"; other missing technical details render \"Not documented\". Offline providers stay visible and cannot launch sign-up.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve exact provider endpoints and referral parameters.",
      "Do pair color with explicit availability text.",
      "Do keep full provider descriptions available in the modal.",
      "Do preserve keyboard focus, mobile announcements and reduced motion.",
      "Do use the same white card structure for featured and ordinary providers."
    ],
    "donts": [
      "Don't invent request rates, latency, uptime, models or auth methods.",
      "Don't replace provider-specific links with placeholder endpoints.",
      "Don't hide offline records or remove their stored URLs.",
      "Don't treat old screenshots or code tests as current rendered verification."
    ]
  }
}
