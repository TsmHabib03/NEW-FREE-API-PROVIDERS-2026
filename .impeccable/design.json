      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><circle cx=\"10.8\" cy=\"10.8\" r=\"7.2\"/><path d=\"m16 16 4.5 4.5\"/></svg><input aria-label=\"Search providers or models\" placeholder=\"Search providers or models…\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:11px;min-height:46px;background:var(--surface-soft,#f8f9fc);border-radius:10px;padding:0 15px;color:var(--muted,#626274)}.ds-search svg{width:19px;height:19px}.ds-search input{width:100%;min-width:0;border:0;background:transparent;color:var(--ink,#222331);font:12px \"DM Sans\",sans-serif;height:46px;outline:0}.ds-search:focus-within{outline:2px solid var(--accent,#4469dc);outline-offset:2px}"
    },
